AGENT_HOST=127.0.0.1
AGENT_PORT=8091
AGENT_CORS_ORIGINS=http://127.0.0.1:8082,http://localhost:8082
AGENT_GRAPH_API_BASE_URL=http://127.0.0.1:4399
AGENT_DATA_DIR=./data
