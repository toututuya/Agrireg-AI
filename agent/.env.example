AGENT_HOST=127.0.0.1
AGENT_PORT=8091
AGENT_CORS_ORIGINS=http://127.0.0.1:8082,http://localhost:8082
AGENT_GRAPH_API_BASE_URL=http://127.0.0.1:4399
AGENT_DATA_DIR=./data
AGENT_REQUEST_TIMEOUT_SECONDS=20
AGENT_MAX_TOOL_STEPS=6

# Optional. Point to Milvus 2.6 to enable registration document search.
AGENT_MILVUS_URI=
AGENT_MILVUS_COLLECTION=agrireg_documents_v1
AGENT_MILVUS_TOKEN=
AGENT_RETRIEVAL_DEVICE=
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional. The agent remains runnable with deterministic planning/reporting when disabled.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

